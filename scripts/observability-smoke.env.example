# Copy this file to an ignored .env file and source it in your shell. Never
# commit tokens or the queue probe document.

export OBS_SMOKE_CORE_URL=https://staging-api.example.com
export OBS_SMOKE_SERVICE=drimsheet-core
export OBS_SMOKE_ENVIRONMENT=staging

# Use the exact Grafana Cloud read endpoints, including /api/v1/query and
# /loki/api/v1/query_range. The access-policy token needs metrics:read and
# logs:read scopes.
export OBS_SMOKE_PROMETHEUS_QUERY_URL=https://prometheus-<region>.grafana.net/api/prom/api/v1/query
export OBS_SMOKE_PROMETHEUS_USERNAME=<metrics-instance-id>
export OBS_SMOKE_LOKI_QUERY_URL=https://logs-prod-<region>.grafana.net/loki/api/v1/query_range
export OBS_SMOKE_LOKI_USERNAME=<logs-instance-id>
export OBS_SMOKE_GRAFANA_READ_TOKEN=<access-policy-token>

export OBS_SMOKE_SENTRY_API_URL=https://sentry.io
export OBS_SMOKE_SENTRY_ORGANIZATION=drimsheet
export OBS_SMOKE_SENTRY_TOKEN=<org-read-token>

# Grafana's receiver-test route is version-specific. Supply the complete route
# and a service-account token authorized to test the saved contact point. Put a
# required request body in an ignored JSON file and set ALERT_BODY_FILE.
export OBS_SMOKE_ALERT_TEST_URL=https://<grafana-host>/<receiver-test-route>
export OBS_SMOKE_GRAFANA_ALERT_TOKEN=<service-account-token>
# export OBS_SMOKE_ALERT_BODY_FILE=/absolute/path/to/.env.observability-alert.json

# Set this only after the test notification is visible at the real destination.
export OBS_SMOKE_ALERT_DELIVERY_CONFIRMED=false

# This ignored file contains synthetic, authenticated HTTP requests that cause
# staging to enqueue work. See docs/observability-operations.md for its schema.
export OBS_SMOKE_QUEUE_PROBES_FILE=/absolute/path/to/.env.observability-queue-probes.json

export OBS_SMOKE_TIMEOUT_MS=120000
export OBS_SMOKE_POLL_INTERVAL_MS=5000
