{
  "entryFile": "src/app/_bootstrap/index.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/**/*.controller.ts"],
  "spec": {
    "outputDirectory": "./generated",
    "basePath": "/api/v1",
    "specVersion": 3,
    "securityDefinitions": {
      "bearerAuth": {
        "type": "http",
        "in": "header",
        "name": "Authorization",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "routes": {
    "routesDir": "./generated",
    "basePath": "/api/v1",
    "authenticationModule": "./src/infra/config/tsoa-express-auth.ts"
  }
}
