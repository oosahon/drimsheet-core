{
  "channel": {
    "exchange": "ingestion.exchange-rate",
    "routing_key": "exchange-rate.ingested"
  },
  "message": {
    "payload": {
      "type": "object",
      "required": [
        "correlation_id",
        "event_type",
        "occurred_at",
        "producer",
        "data"
      ],
      "properties": {
        "correlation_id": { "type": "string", "format": "uuid" },
        "event_type": { "const": "exchange-rate.ingested.v1" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "producer": { "const": "drimsheet-ingestion" },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "base_currency_code",
              "target_currency_code",
              "rate",
              "rate_class",
              "as_of",
              "source"
            ],
            "properties": {
              "base_currency_code": { "type": "string" },
              "target_currency_code": { "type": "string" },
              "rate": {
                "type": "string",
                "description": "Decimal value as string"
              },
              "rate_class": {
                "type": "string",
                "enum": ["official", "market"]
              },
              "as_of": { "type": "string", "format": "date" },
              "source": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
