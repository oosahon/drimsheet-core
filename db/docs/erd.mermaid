erDiagram

audit_accounting_context_history {
    uuid id PK
    uuid accounting_context_id
    uuid accounting_entity_id
    uuid user_id FK
    audit_history_actor_type actor_type
    varchar_50_ action
    jsonb diff
    text note
    varchar_255_ correlation_id
    timestamptz occurred_at
    timestamptz recorded_at
}

audit_accounting_entity_history {
    uuid id PK
    uuid accounting_entity_id
    uuid user_id FK
    audit_history_actor_type actor_type
    varchar_50_ action
    jsonb diff
    text note
    varchar_255_ correlation_id
    timestamptz occurred_at
    timestamptz recorded_at
}

audit_accounting_period_history {
    uuid id PK
    uuid accounting_period_id
    uuid accounting_entity_id
    uuid user_id FK
    audit_history_actor_type actor_type
    varchar_50_ action
    jsonb diff
    text note
    varchar_255_ correlation_id
    timestamptz occurred_at
    timestamptz recorded_at
}

audit_fiscal_year_history {
    uuid id PK
    uuid fiscal_year_id
    uuid accounting_entity_id
