    uuid user_id FK
    audit_history_actor_type actor_type
    varchar_50_ action
    jsonb diff
    text note
    varchar_255_ correlation_id
    timestamptz occurred_at
    timestamptz recorded_at
}

audit_user_activities {
    uuid id PK
    uuid user_id FK
    varchar_150_ event_key
    varchar_100_ description
    jsonb meta
    timestamptz created_at
}

audit_user_profile_history {
    uuid id PK
    uuid user_profile_id
    uuid user_id FK
    audit_history_actor_type actor_type
    varchar_50_ action
    jsonb diff
    text note
    varchar_255_ correlation_id
    timestamptz occurred_at
    timestamptz recorded_at
}

core_accounting_contexts {
    uuid id PK
    varchar_150_ name
    varchar_255_ description
    uuid accounting_entity_id FK
    varchar_15_ accounting_standard_code FK
    uuid fiscal_year_id FK
    uuid current_operating_period_id FK
    timestamptz created_at
    timestamptz updated_at
    timestamptz closed_at
}

core_accounting_entities {
    uuid id PK
    core_accounting_entity_type type
    varchar_255_ name
    uuid owner_id FK
    varchar_3_ functional_currency_code FK
    varchar_2_ jurisdiction_code FK
    timestamptz created_at
    timestamptz updated_at
}

core_accounting_periods {
    uuid id PK
    varchar_150_ name
    uuid accounting_entity_id FK
    uuid fiscal_year_id FK
    core_period_unit unit
    smallint count
    date start_date
    date end_date
    core_period_status status
    timestamptz closed_at
    timestamptz updated_at
}

core_accounting_standards {
    varchar_15_ code PK
    varchar_100_ name
    varchar_200_ link
    boolean is_supported
    timestamptz created_at
    timestamptz updated_at
    timestamptz deleted_at
}

core_counterparties {
    uuid id PK
    varchar_100_ name
    timestamptz created_at
    timestamptz updated_at
}

core_currencies {
    varchar_3_ code PK
    varchar_5_ symbol
    varchar_50_ name
    smallint minor_unit
    timestamptz created_at
    timestamptz updated_at
    timestamptz deleted_at
}

core_currency_exchange_rates {
    bigint id PK
    varchar_7_ currency_pair
    varchar_3_ base_currency_code FK
    varchar_3_ target_currency_code FK
    numeric rate
    core_currency_exchange_rate_type type
    date as_of
    varchar_100_ source
    timestamptz created_at
}

core_fiscal_years {
    uuid id PK
    varchar_150_ name
    uuid accounting_entity_id FK
    core_fiscal_year_period_unit unit
    smallint count
    date start_date
    date end_date
    core_period_status status
    timestamptz closed_at
    timestamptz updated_at
}

core_journal_entries {
    uuid id PK
    uuid accounting_entity_id FK
    core_journal_entry_source_type source_type
    uuid counterparty_id FK
    varchar_100_ memo
    core_journal_entry_status status
    date effective_date
    timestamptz posted_at
    timestamptz voided_at
    uuid voiding_entry_id FK
    integer version
    uuid created_by FK
    timestamptz created_at
    timestamptz updated_at
}

core_journal_entry_attachments {
    uuid id PK
    uuid journal_entry_id FK
    jsonb data
    timestamptz created_at
    timestamptz updated_at
}

core_journal_lines {
    uuid id PK
    uuid entry_id FK
    uuid account_id FK
    integer sequence_order
    bigint amount
    varchar_3_ currency_code FK
    jsonb exchange_rate
    bigint functional_amount
    varchar_3_ functional_currency_code FK
    core_journal_side side
    varchar_100_ description
    jsonb meta
    integer version
    timestamptz created_at
    timestamptz updated_at
}

core_jurisdiction_accounting_standards {
    varchar_2_ jurisdiction_code PK,FK
    varchar_15_ accounting_standard_code PK,FK
    core_accounting_entity_type accounting_entity_type PK
    timestamptz created_at
    timestamptz updated_at
}

core_jurisdictions {
    varchar_2_ code PK
    varchar_70_ name
    varchar_3_ currency_code FK
    timestamptz created_at
    timestamptz updated_at
    timestamptz deleted_at
}

core_ledger_account_balance_adjustments {
    uuid id PK
    uuid ledger_account_id FK
    bigint amount
    varchar_3_ currency_code FK
    bigint functional_amount
    varchar_3_ functional_currency_code FK
    uuid journal_entry_id FK
    core_ledger_account_balance_effect effect
    uuid created_by FK
    timestamptz created_at
}

core_ledger_account_balances {
    uuid ledger_account_id PK,FK
    uuid accounting_entity_id FK
    varchar_100_ account_materialized_path
    bigint amount
    varchar_3_ currency_code FK
    bigint functional_amount
    varchar_3_ functional_currency_code FK
    integer version
    timestamptz created_at
    timestamptz updated_at
}

core_ledger_accounts {
    uuid id PK
    varchar_6_ code
    varchar_100_ materialized_path
    uuid accounting_entity_id FK
    core_ledger_type type
    core_normal_balance_type normal_balance
    varchar sub_type
    varchar behavior
    boolean is_control_account
    uuid control_account_id FK
    varchar_100_ name
    varchar_3_ currency_code FK
    core_ledger_account_status status
    core_contra_account_rule contra_account_rule
    core_adjunct_account_rule adjunct_account_rule
    jsonb meta
    uuid created_by FK
    timestamptz created_at
    timestamptz updated_at
    timestamptz deleted_at
}

core_reporting_contexts {
    uuid id PK
    varchar_150_ name
    varchar_255_ description
    uuid accounting_entity_id FK
    varchar_3_ reporting_currency_code FK
    uuid accounting_context_id FK
    uuid current_reporting_period_id FK
    varchar_15_ accounting_standard_code FK
    timestamptz created_at
    timestamptz updated_at
    timestamptz closed_at
}

core_reporting_periods {
    uuid id PK
    varchar_150_ name
    uuid accounting_entity_id FK
    uuid fiscal_year_id FK
    core_period_unit unit
    smallint count
    date start_date
    date end_date
    timestamptz updated_at
}

core_user_auth {
    uuid user_id PK,FK
    varchar_200_ password
    integer failed_login_attempts
    _varchar___ strategies
    timestamptz created_at
    timestamptz updated_at
}

core_user_preferences {
    uuid id PK,FK
    jsonb app_preferences
    timestamptz created_at
    timestamptz updated_at
}

core_user_sessions {
    uuid id PK
    uuid user_id FK
    text refresh_token
    timestamptz last_login_at
    timestamptz created_at
}

core_users {
    uuid id PK
    varchar_100_ first_name
    varchar_100_ last_name
    varchar_200_ email
    boolean email_verified
    timestamptz created_at
    timestamptz updated_at
    timestamptz deleted_at
}

