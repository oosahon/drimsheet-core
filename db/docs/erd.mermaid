    audit_history_actor_type actor_type
    varchar_50_ action
    jsonb diff
    text note
    varchar_255_ correlation_id
    timestamptz occurred_at
    timestamptz recorded_at
}

audit_journal_entry_history {
    uuid id PK
    uuid journal_entry_id
    uuid accounting_entity_id
    uuid user_id FK
    audit_history_actor_type actor_type
    varchar_50_ action
    jsonb diff
    text note
    varchar_255_ correlation_id
    integer entity_version
    timestamptz occurred_at
    timestamptz recorded_at
}

