            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IUserPreferences"
                }
              }
            }
          }
        },
        "description": "Get user preferences",
        "tags": ["User"],
        "security": [],
        "parameters": []
