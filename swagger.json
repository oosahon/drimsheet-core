{
  "openapi": "3.0.0",
  "components": {
    "examples": {},
    "headers": {},
    "parameters": {},
    "requestBodies": {},
    "responses": {},
    "schemas": {
      "TEntityId": {
        "allOf": [
          {
            "type": "string"
          },
          {
            "properties": {
              "__brand": {
                "type": "string",
                "enum": ["uuid"],
                "nullable": false
              }
            },
            "required": ["__brand"],
            "type": "object"
          }
        ]
      },
      "UAppThemePreference": {
        "type": "string",
        "enum": ["light", "dark", "system"]
      },
      "UAppUsageModePreference": {
        "type": "string",
        "enum": ["power_user", "non_power_user"]
      },
      "IUserAppPreferences": {
        "properties": {
          "theme": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UAppThemePreference"
              }
            ],
            "nullable": true
          },
          "appUsageMode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UAppUsageModePreference"
              }
            ],
            "nullable": true
          }
        },
        "type": "object",
        "additionalProperties": false
      },
      "IUserPreferences": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/TEntityId"
          },
          "appPreferences": {
            "$ref": "#/components/schemas/IUserAppPreferences"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "appPreferences", "createdAt", "updatedAt"],
        "type": "object",
        "additionalProperties": false
      },
      "IApiValidationError": {
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["field", "message"],
        "type": "object",
        "additionalProperties": false
      },
      "IApiError": {
        "properties": {
          "message": {
            "type": "string"
          },
          "validationErrors": {
            "items": {
              "$ref": "#/components/schemas/IApiValidationError"
            },
            "type": "array"
          },
          "cause": {}
        },
        "required": ["message"],
        "type": "object",
        "additionalProperties": false
      },
      "IUser": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/TEntityId"
          },
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "emailVerified",
          "firstName",
          "lastName",
          "createdAt",
          "updatedAt",
          "deletedAt"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "IUserSignupReq": {
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["firstName", "lastName", "email", "password"],
        "type": "object",
        "additionalProperties": false
      },
      "IAccessToken": {
        "properties": {
          "accessToken": {
            "type": "string"
          }
        },
        "required": ["accessToken"],
        "type": "object",
        "additionalProperties": false
      },
      "IEmailLoginReq": {
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["email", "password"],
        "type": "object",
        "additionalProperties": false
      },
      "IResetPasswordReq": {
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "confirmPassword": {
            "type": "string"
          }
        },
        "required": ["token", "password", "confirmPassword"],
        "type": "object",
        "additionalProperties": false
      },
      "IMoneyDto": {
        "properties": {
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currencyCode": {
            "type": "string"
          },
          "isMinorUnit": {
            "type": "boolean"
          }
        },
        "required": ["amount", "currencyCode", "isMinorUnit"],
        "type": "object",
        "additionalProperties": false
      },
      "UExchangeRateType": {
        "type": "string",
        "enum": ["official", "negotiated"]
      },
      "IExchangeRateDto": {
        "properties": {
          "baseCurrencyCode": {
            "type": "string"
          },
          "targetCurrencyCode": {
            "type": "string"
          },
          "rate": {
            "type": "number",
            "format": "double"
          },
          "type": {
            "$ref": "#/components/schemas/UExchangeRateType"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          },
          "id": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "baseCurrencyCode",
          "targetCurrencyCode",
          "rate",
          "type",
          "asOf",
          "source"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "IOpeningBalanceDto": {
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/IMoneyDto"
          },
          "exchangeRate": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IExchangeRateDto"
              }
            ],
            "nullable": true
          }
        },
        "required": ["amount", "exchangeRate"],
        "type": "object",
        "additionalProperties": false
      },
      "IPettyCashAccountCreationReq": {
        "properties": {
          "name": {
            "type": "string"
          },
          "currencyCode": {
            "type": "string"
          },
          "isControlAccount": {
            "type": "boolean"
