          "controlAccountCode": {
            "type": "string"
          },
          "openingBalance": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IOpeningBalanceDto"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "name",
          "currencyCode",
          "isControlAccount",
          "openingBalance"
        ],
        "type": "object",
        "additionalProperties": false
      }
