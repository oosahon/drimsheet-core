{
  "openapi": "3.0.0",
  "components": {
    "examples": {},
    "headers": {},
    "parameters": {},
    "requestBodies": {},
    "responses": {},
    "schemas": {
      "TEntityId": {
        "allOf": [
          {
            "type": "string"
          },
          {
            "properties": {
              "__brand": {
                "type": "string",
                "enum": ["uuid"],
                "nullable": false
              }
            },
            "required": ["__brand"],
            "type": "object"
          }
        ]
      },
      "UAppThemePreference": {
        "type": "string",
        "enum": ["light", "dark", "system"]
      },
      "UAppUsageMode": {
        "type": "string",
        "enum": ["power_user", "non_power_user"]
      },
      "IUserAppPreferences": {
        "properties": {
          "theme": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UAppThemePreference"
              }
            ],
            "nullable": true
          },
          "appUsageMode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UAppUsageMode"
              }
            ],
            "nullable": true
          }
        },
        "type": "object",
        "additionalProperties": false
      },
      "IUserPreferences": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/TEntityId"
          },
          "appPreferences": {
            "$ref": "#/components/schemas/IUserAppPreferences"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "appPreferences", "createdAt", "updatedAt"],
        "type": "object",
        "additionalProperties": false
      },
      "Pick_IUser.Exclude_keyofIUser.password__": {
        "properties": {},
        "type": "object",
        "description": "From T, pick a set of properties whose keys are in the union K"
      },
      "Omit_IUser.password_": {
        "$ref": "#/components/schemas/Pick_IUser.Exclude_keyofIUser.password__",
        "description": "Construct a type with the properties of T except for those in type K."
      },
      "UAccountingEntityType": {
        "type": "string",
        "enum": ["individual", "sole_trader", "company"]
      },
      "IFiscalYearStart": {
        "description": "Represents the month and day on which an accounting entity's fiscal year ends.\nDefaults to December 31 for individuals. Companies and sole traders\nmay configure any valid calendar date (e.g., March 31, June 30).",
        "properties": {
          "month": {
            "type": "number",
            "format": "double"
          },
          "day": {
            "type": "number",
            "format": "double"
          }
        },
        "required": ["month", "day"],
        "type": "object",
        "additionalProperties": false
      },
      "IAccountingEntityOnboardingReq": {
        "properties": {
          "name": {
            "type": "string"
          },
          "entityType": {
            "$ref": "#/components/schemas/UAccountingEntityType"
          },
          "operatingCountryCode": {
            "type": "string"
          },
          "functionalCurrencyCode": {
            "type": "string"
          },
          "reportingCurrencyCode": {
            "type": "string"
          },
          "fiscalYearStart": {
            "$ref": "#/components/schemas/IFiscalYearStart"
          },
          "appUsageMode": {
            "$ref": "#/components/schemas/UAppUsageMode"
          }
        },
        "required": [
          "name",
          "entityType",
          "operatingCountryCode",
          "functionalCurrencyCode",
          "reportingCurrencyCode",
          "fiscalYearStart",
          "appUsageMode"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "IApiValidationError": {
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["field", "message"],
        "type": "object",
        "additionalProperties": false
      },
      "IApiError": {
        "properties": {
          "message": {
            "type": "string"
          },
          "validationErrors": {
            "items": {
              "$ref": "#/components/schemas/IApiValidationError"
            },
            "type": "array"
          },
          "cause": {}
        },
        "required": ["message"],
        "type": "object",
        "additionalProperties": false
      },
      "IUserSignupReq": {
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["firstName", "lastName", "email", "password"],
        "type": "object",
        "additionalProperties": false
      },
      "IAuthRes": {
        "properties": {
          "authToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": ["authToken", "refreshToken"],
        "type": "object",
        "additionalProperties": false
      },
      "Pick_IAccountingEntity.Exclude_keyofIAccountingEntity.functionalCurrency-or-reportingCurrency__": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/TEntityId"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "operatingCountryCode": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/UAccountingEntityType"
          },
          "ownerId": {
            "$ref": "#/components/schemas/TEntityId"
          },
          "fiscalYearStart": {
            "$ref": "#/components/schemas/IFiscalYearStart"
          }
        },
        "required": [
          "id",
          "createdAt",
          "updatedAt",
          "deletedAt",
          "name",
          "operatingCountryCode",
          "type",
          "ownerId",
          "fiscalYearStart"
        ],
        "type": "object",
        "description": "From T, pick a set of properties whose keys are in the union K"
      },
      "IAccountingEntityRes": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/TEntityId"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "operatingCountryCode": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/UAccountingEntityType"
          },
          "ownerId": {
            "$ref": "#/components/schemas/TEntityId"
          },
          "fiscalYearStart": {
            "$ref": "#/components/schemas/IFiscalYearStart"
          },
          "functionalCurrency": {
            "type": "string"
          },
          "reportingCurrency": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "createdAt",
          "updatedAt",
          "deletedAt",
          "name",
          "operatingCountryCode",
          "type",
          "ownerId",
          "fiscalYearStart",
          "functionalCurrency",
          "reportingCurrency"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "in": "header",
        "name": "Authorization",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "info": {
    "title": "purple-ledger-core",
    "version": "1.0.0",
    "description": "This repo contains the server-side source code for Purple Ledger's bookkeeping and tax app.",
    "license": {
      "name": "AGPL-3.0-or-later"
    },
    "contact": {
      "name": "Osahon Oboite"
    }
  },
  "paths": {
