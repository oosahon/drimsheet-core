Project purple_ledger {
  database_type: 'PostgreSQL'
  Note: 'Purple Ledger Database Schema'
}

// ==========================================
// Enum Types
// ==========================================

Enum core__accounting_entity_type {
  individual
  sole_trader
  private_company
}

Enum core__fiscal_year_period_unit {
  month
}

Enum core__period_unit {
  day
  week
  month
  quarter
  year
}

Enum core__period_status {
  pending
  open
  closing
  closed
}

Enum core__currency_exchange_rate_type {
  official
  negotiated
}

Enum core__ledger_type {
  asset
  liability
  equity
  revenue
  expense
}

Enum core__normal_balance_type {
  debit
  credit
}

Enum core__ledger_account_status {
  active
  archived
}

Enum core__contra_account_rule {
  contra_permitted
  contra_not_permitted
  contra_only
  contra_not_applicable
}

Enum core__adjunct_account_rule {
  adjunct_permitted
  adjunct_not_permitted
  adjunct_only
  adjunct_not_applicable
}

Enum core__category_status {
  active
  archived
}

Enum audit__category_history_action_type {
  created
  updated
  archived
  unarchived
}

Enum core__transaction_types {
  sale
  purchase
  credit_note
  debit_note
  expense
  transfer
  payment
  receipt
}

Enum core__transaction_status {
  pending
  posted
  voided
  archived
}

Enum core__journal_entry_status {
  draft
  posted
  voided
}

Enum core__journal_side {
  debit
  credit
}

Enum core__ledger_account_balance_effect {
  increase
  decrease
  noop
}


// ==========================================
// Users Domain (core schema)
// ==========================================

Table users {
  id uuid [pk, default: `uuid_generate_v4()`]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(200) [unique, not null]
  email_verified boolean [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Schema: core'
}

Table user_auth {
  user_id uuid [pk, ref: - users.id]
  password varchar(200)
  failed_login_attempts integer [default: 0]
  strategies "varchar(50)[]" [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Schema: core'
}

Table user_sessions {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null]
  refresh_token text [unique, not null]
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, refresh_token) [unique]
  }

  Note: 'Schema: core'
}
Ref: user_sessions.user_id > users.id [delete: cascade]

Table user_preferences {
  id uuid [pk, ref: - users.id]
  app_preferences jsonb
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Note: 'Schema: core'
}


// ==========================================
// User Activities (audit schema)
// ==========================================

Table user_activities {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid
  event_key varchar(150) [not null]
  description varchar(100) [not null]
  meta jsonb
  created_at timestamptz [not null, default: `now()`]

  Note: 'Schema: audit'
}
Ref: user_activities.user_id > users.id [delete: cascade]


// ==========================================
// Core Config Domain (core schema)
// ==========================================

Table currencies {
  code varchar(3) [pk]
  symbol varchar(5) [not null]
  name varchar(50) [not null]
  minor_unit smallint [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Schema: core'
}

Table accounting_standards {
  code varchar(15) [pk]
  name varchar(100) [not null]
  link varchar(200)
  is_supported boolean [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Schema: core'
}

Table jurisdictions {
  code varchar(2) [pk]
  name varchar(70) [not null]
  currency_code varchar(3) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Schema: core'
}
Ref: jurisdictions.currency_code > currencies.code [delete: restrict]

Table jurisdiction_accounting_standards {
  jurisdiction_code varchar(2) [pk, not null]
  accounting_standard_code varchar(15) [pk, not null]
  accounting_entity_type core__accounting_entity_type [pk, not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Schema: core. Composite PK: (jurisdiction_code, accounting_standard_code, accounting_entity_type)'
}
Ref: jurisdiction_accounting_standards.jurisdiction_code > jurisdictions.code [delete: cascade]
Ref: jurisdiction_accounting_standards.accounting_standard_code > accounting_standards.code [delete: cascade]

Table currency_exchange_rates {
  id bigserial [pk]
  currency_pair varchar(7) [not null]
  base_currency_code varchar(3) [not null]
  target_currency_code varchar(3) [not null]
  rate numeric [not null]
  type core__currency_exchange_rate_type [not null]
  as_of date [not null]
  source varchar(100) [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Schema: core'
}
Ref: currency_exchange_rates.base_currency_code > currencies.code
Ref: currency_exchange_rates.target_currency_code > currencies.code


// ==========================================
// Accounting Entities Domain (core schema)
// ==========================================

Table accounting_entities {
  id uuid [pk, default: `uuid_generate_v4()`]
  type core__accounting_entity_type [not null]
  name varchar(255) [not null]
  owner_id uuid [not null]
  functional_currency_code varchar(3) [not null]
  jurisdiction_code varchar(2) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Schema: core'
}
Ref: accounting_entities.owner_id > users.id [delete: cascade]
Ref: accounting_entities.functional_currency_code > currencies.code
Ref: accounting_entities.jurisdiction_code > jurisdictions.code

Table fiscal_years {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(150) [not null]
  accounting_entity_id uuid [not null]
  unit core__fiscal_year_period_unit [not null]
  count smallint [not null]
  start_date date [not null]
  end_date date [not null]
  status core__period_status [not null]
  closed_at timestamptz
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Schema: core'
}
Ref: fiscal_years.accounting_entity_id > accounting_entities.id [delete: cascade]

Table accounting_periods {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(150) [not null]
  accounting_entity_id uuid [not null]
  fiscal_year_id uuid [not null]
  unit core__period_unit [not null]
  count smallint [not null]
  start_date date [not null]
  end_date date [not null]
  status core__period_status [not null]
  closed_at timestamptz
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Schema: core'
}
Ref: accounting_periods.accounting_entity_id > accounting_entities.id [delete: cascade]
Ref: accounting_periods.fiscal_year_id > fiscal_years.id [delete: cascade]

Table accounting_contexts {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(150) [not null]
  description varchar(255)
  accounting_entity_id uuid [not null]
  accounting_standard_code varchar(15) [not null]
  fiscal_year_id uuid [not null]
  current_operating_period_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  closed_at timestamptz

  Note: 'Schema: core'
}
Ref: accounting_contexts.accounting_entity_id > accounting_entities.id [delete: cascade]
Ref: accounting_contexts.accounting_standard_code > accounting_standards.code [delete: restrict]
Ref: accounting_contexts.fiscal_year_id > fiscal_years.id [delete: cascade]
Ref: accounting_contexts.current_operating_period_id > accounting_periods.id [delete: restrict]

Table reporting_periods {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(150) [not null]
  accounting_entity_id uuid [not null]
  fiscal_year_id uuid [not null]
  unit core__period_unit [not null]
  count smallint [not null]
  start_date date [not null]
  end_date date [not null]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Schema: core'
}
Ref: reporting_periods.accounting_entity_id > accounting_entities.id [delete: cascade]
Ref: reporting_periods.fiscal_year_id > fiscal_years.id [delete: cascade]

Table reporting_contexts {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(150) [not null]
  description varchar(255)
  accounting_entity_id uuid [not null]
  reporting_currency_code varchar(3) [not null]
  accounting_context_id uuid [not null]
  current_reporting_period_id uuid [not null]
  accounting_standard_code varchar(15) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  closed_at timestamptz

  Note: 'Schema: core'
}
Ref: reporting_contexts.accounting_entity_id > accounting_entities.id [delete: cascade]
Ref: reporting_contexts.reporting_currency_code > currencies.code [delete: restrict]
Ref: reporting_contexts.accounting_context_id > accounting_contexts.id [delete: restrict]
Ref: reporting_contexts.current_reporting_period_id > reporting_periods.id [delete: restrict]
Ref: reporting_contexts.accounting_standard_code > accounting_standards.code [delete: restrict]


// ==========================================
// Ledgers & Balances Domain (core schema)
// ==========================================

Table ledger_accounts {
  id uuid [pk, default: `uuid_generate_v4()`]
  code varchar(6) [not null]
  materialized_path varchar(100) [not null]
  accounting_entity_id uuid [not null]
  type core__ledger_type [not null]
  normal_balance core__normal_balance_type [not null]
  sub_type varchar [not null]
  behavior varchar [not null]
  is_control_account boolean [not null, default: false]
  control_account_id uuid
  name varchar(100) [not null]
  currency_code varchar(3) [not null]
  status core__ledger_account_status [not null]
  contra_account_rule core__contra_account_rule [not null]
  adjunct_account_rule core__adjunct_account_rule [not null]
  meta jsonb
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (code, accounting_entity_id) [unique, name: 'ledger_accounts_code_accounting_entity_id_uk']
    (materialized_path, accounting_entity_id) [unique, name: 'ledger_accounts_path_accounting_entity_id_uk']
  }

  Note: 'Schema: core'
}
Ref: ledger_accounts.accounting_entity_id > accounting_entities.id [delete: cascade]
Ref: ledger_accounts.control_account_id > ledger_accounts.id [delete: restrict]
Ref: ledger_accounts.currency_code > currencies.code [delete: restrict]
Ref: ledger_accounts.created_by > users.id [delete: cascade]

Table categories {
  id uuid [pk, default: `uuid_generate_v4()`]
  accounting_entity_id uuid [not null]
  account_id uuid [not null]
  account_materialized_path varchar(100) [not null]
  version integer [not null, default: 1]
  status core__category_status [not null]
  name varchar(100) [not null]
  is_grouping boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Schema: core'
}
Ref: categories.accounting_entity_id > accounting_entities.id [delete: cascade]
Ref: categories.account_id > ledger_accounts.id [delete: cascade]

Table category_history {
  id bigserial [pk]
  category_id uuid [not null]
  user_id uuid [not null]
  action audit__category_history_action_type [not null]
  diff jsonb [not null]
  note varchar(100)
  created_at timestamptz [not null, default: `now()`]

  Note: 'Schema: audit'
}
Ref: category_history.category_id > categories.id
Ref: category_history.user_id > users.id

Table ledger_account_balances {
  ledger_account_id uuid [pk]
  accounting_entity_id uuid [not null]
  account_materialized_path varchar(100) [not null]
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null]
  functional_amount bigint [not null, default: 0]
  functional_currency_code varchar(3) [not null]
  version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (account_materialized_path, accounting_entity_id) [unique, name: 'ledger_account_balances_path_entity_id_uk']
  }

  Note: 'Schema: core'
}
Ref: ledger_account_balances.ledger_account_id - ledger_accounts.id [delete: cascade]
Ref: ledger_account_balances.accounting_entity_id > accounting_entities.id [delete: cascade]
Ref: ledger_account_balances.currency_code > currencies.code [delete: restrict]
Ref: ledger_account_balances.functional_currency_code > currencies.code [delete: restrict]

Table ledger_account_balance_adjustments {
  id uuid [pk, default: `gen_random_uuid()`]
  ledger_account_id uuid [not null]
  amount bigint [not null]
  currency_code varchar(3) [not null]
  functional_amount bigint [not null]
  functional_currency_code varchar(3) [not null]
  journal_entry_id uuid [not null]
  transaction_id uuid
  effect core__ledger_account_balance_effect [not null]
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Schema: core'
}
Ref: ledger_account_balance_adjustments.ledger_account_id > ledger_accounts.id [delete: cascade]
Ref: ledger_account_balance_adjustments.currency_code > currencies.code [delete: restrict]
Ref: ledger_account_balance_adjustments.functional_currency_code > currencies.code [delete: restrict]
Ref: ledger_account_balance_adjustments.journal_entry_id > journal_entries.id [delete: cascade]
Ref: ledger_account_balance_adjustments.transaction_id > transactions.id [delete: cascade]
Ref: ledger_account_balance_adjustments.created_by > users.id [delete: cascade]


// ==========================================
// Transactions & Journals Domain (core schema)
// ==========================================

Table transactions {
  id uuid [pk, default: `uuid_generate_v4()`]
  accounting_entity_id uuid [not null]
  reference varchar(100) [unique, not null]
  type core__transaction_types [not null]
  effective_date date [not null]
  created_by uuid [not null]
  source_account_id uuid [not null]
  amount bigint [not null]
  currency_code varchar(3) [not null]
  exchange_rate jsonb [not null]
  functional_amount bigint [not null]
  notes varchar(100)
  version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Schema: core'
}
Ref: transactions.accounting_entity_id > accounting_entities.id [delete: cascade]
Ref: transactions.created_by > users.id
Ref: transactions.source_account_id > ledger_accounts.id
Ref: transactions.currency_code > currencies.code

Table transaction_lines {
  id uuid [pk, default: `uuid_generate_v4()`]
  transaction_id uuid [not null]
  target_account_id uuid [not null]
  amount bigint [not null]
  currency_code varchar(3) [not null]
  functional_amount bigint [not null]
  description varchar(100)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Schema: core'
}
Ref: transaction_lines.transaction_id > transactions.id
Ref: transaction_lines.target_account_id > ledger_accounts.id
Ref: transaction_lines.currency_code > currencies.code

Table journal_entries {
  id uuid [pk]
  accounting_entity_id uuid [not null]
  transaction_id uuid
  memo varchar(100)
  status core__journal_entry_status [not null]
  effective_date date [not null]
  posted_at timestamptz
  voided_at timestamptz
  voiding_entry_id uuid
  version integer [not null, default: 1]
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Schema: core'
}
Ref: journal_entries.accounting_entity_id > accounting_entities.id [delete: cascade]
Ref: journal_entries.transaction_id > transactions.id
Ref: journal_entries.voiding_entry_id > journal_entries.id
Ref: journal_entries.created_by > users.id [delete: cascade]

Table journal_lines {
  id uuid [pk]
  entry_id uuid [not null]
  account_id uuid [not null]
  sequence_order integer [not null]
  amount bigint [not null]
  currency_code varchar(3) [not null]
  exchange_rate jsonb
  functional_amount bigint [not null]
  functional_currency_code varchar(3) [not null]
  side core__journal_side [not null]
  description varchar(100)
  meta jsonb
  version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Schema: core'
}
Ref: journal_lines.entry_id > journal_entries.id [delete: cascade]
Ref: journal_lines.account_id > ledger_accounts.id [delete: cascade]
Ref: journal_lines.currency_code > currencies.code [delete: restrict]
Ref: journal_lines.functional_currency_code > currencies.code [delete: restrict]
